{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "existingSecret", "managedNamespace", "clusterID", "resources"],
  "properties": {
    "managedNamespace": {"type": "string", "enum": ["rp-demo"]},
    "existingSecret": {"type": "string", "minLength": 1},
    "clusterID": {"type": "string", "minLength": 1},
    "kubernetesEnabled": {"type": "boolean"},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}
