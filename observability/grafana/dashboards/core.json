{
  "uid": "target-reconciliation-service-core",
  "title": "TargetReconciliationService \u00b7 Core Reliability",
  "tags": [
    "target-reconciliation-service",
    "live-backend"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "target-reconciliation-service-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(trs_http_requests_total[5m])",
          "legendFormat": "requests / second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "API failure ratio (not a service SLO)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "target-reconciliation-service-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "target-reconciliation-service:http_failure_ratio5m",
          "legendFormat": "API failures / requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Cluster telemetry age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "target-reconciliation-service-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - trs_cluster_last_seen_seconds",
          "legendFormat": "{{cluster}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Available Deployment replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "target-reconciliation-service-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "trs_deployment_available_replicas",
          "legendFormat": "{{cluster}} {{namespace}} {{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Desired Deployment replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "target-reconciliation-service-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "trs_deployment_desired_replicas",
          "legendFormat": "{{cluster}} {{namespace}} {{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Incidents by persisted state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "target-reconciliation-service-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "trs_incidents",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "editable": false,
  "description": "Actual API process counters and PostgreSQL-backed observations. Empty series mean no observations have been collected; no synthetic metrics are seeded."
}
